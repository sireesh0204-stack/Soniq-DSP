<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="110dp"
    android:height="32dp"
    android:viewportWidth="400"
    android:viewportHeight="120">

    <!-- Recessed dark chassis track -->
    <path
        android:pathData="M 40,10 L 360,10 C 390,10 390,110 360,110 L 40,110 C 10,110 10,10 40,10 Z"
        android:fillColor="#161A24" />

    <!-- a - S - Z - S - D (with micro-spacing) -->
    <path
        android:pathData="
            M 90,25 C 50,25 50,95 90,95 
            M 105,25 L 165,25 M 105,25 L 165,95 M 105,95 L 165,95 
            M 180,95 L 240,95 M 180,95 L 240,25 M 180,25 L 240,25 
            M 255,25 L 315,25 M 255,25 L 315,95 M 255,95 L 315,95 
            M 330,25 C 370,25 370,95 330,95"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7">
        
        <!-- Dual-tone gradient: Cyber Cyan to Satin Gold -->
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="50"
                android:startY="60"
                android:endX="370"
                android:endY="60"
                android:type="linear">
                <item android:offset="0" android:color="#00F0FF" />
                <item android:offset="1" android:color="#E5B869" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
