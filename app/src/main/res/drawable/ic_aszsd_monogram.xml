<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="110dp"
    android:height="32dp"
    android:viewportWidth="400"
    android:viewportHeight="120">

    <!-- Connected a-S-Z-S-D Monogram -->
    <path
        android:pathData="
            M 90,25 
            C 50,25 50,95 90,95 
            L 165,95 
            L 105,25 
            L 240,25 
            L 180,95 
            L 315,95 
            L 255,25 
            L 330,25 
            C 370,25 370,95 330,95"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7">
        
        <!-- Dual-tone gradient: Cyber Cyan to Satin Gold -->
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="50"
                android:startY="60"
                android:endX="370"
                android:endY="60"
                android:type="linear">
                <item android:offset="0" android:color="#00F0FF" />
                <item android:offset="1" android:color="#E5B869" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
