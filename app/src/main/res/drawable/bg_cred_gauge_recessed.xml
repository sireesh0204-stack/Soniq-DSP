<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Inset Shadow Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0A0C0F" />
            <stroke
                android:width="2dp"
                android:color="#050608" />
        </shape>
    </item>
    <!-- Inner Subtle Glow -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#0F1217"
                android:startColor="#161A22" />
            <stroke
                android:width="1dp"
                android:color="#1F2532" />
        </shape>
    </item>
</layer-list>

