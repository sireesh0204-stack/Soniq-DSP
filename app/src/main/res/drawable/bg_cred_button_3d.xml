<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Extrusion Base Shadow -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#08090C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 3D Tactile Surface with Top Inset Highlight -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1C212B"
                android:startColor="#252C3A" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#3D475C" />
        </shape>
    </item>
</layer-list>

