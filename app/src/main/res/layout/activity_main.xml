<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E12"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:letterSpacing="0.22"
        android:text="S O N I Q  //  S T U D I O  D S P"
        android:textColor="#E5B869"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llProfiles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeader">

        <Button
            android:id="@+id/btnProfileOriginal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#00F0FF"
            android:text="ORIGINAL"
            android:textColor="#0C0E12"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnProfileDolby"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#161922"
            android:text="DOLBY"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnProfileXiaomi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#161922"
            android:text="XIAOMI"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTelemetry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="Harman 2019v2 Target Bit-Perfect Restore | -2.5dB Headroom"
        android:textColor="#9E9E9E"
        android:textSize="11.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llProfiles" />

    <TextView
        android:id="@+id/tvCodecStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#141822"
        android:gravity="center"
        android:letterSpacing="0.10"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="@string/default_codec_telemetry"
        android:textColor="#00F0FF"
        android:textSize="10.5sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTelemetry" />

    <!-- Visualizer is now compressed naturally by enlarged top/bottom margins -->
    <com.audiophile.buds2prooptimizer.ui.AetherVisualizerView
        android:id="@+id/visualizer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/btnMasterToggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCodecStatus" />

    <Button
        android:id="@+id/btnMasterToggle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#161922"
        android:letterSpacing="0.1"
        android:text="[ BYPASSED ]"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnHyperOs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#E5B869"
        app:strokeWidth="1.2dp" />

    <Button
        android:id="@+id/btnHyperOs"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#161922"
        android:letterSpacing="0.08"
        android:text="ENGAGE HYPEROS SOUND ENGINE"
        android:textColor="#00F0FF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@id/llToggles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#00F0FF"
        app:strokeWidth="0.8dp" />

    <LinearLayout
        android:id="@+id/llToggles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/ivAszsdWatermark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <CheckBox
            android:id="@+id/cbHaptics"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="20dp"
            android:buttonTint="#E5B869"
            android:checked="true"
            android:text="HAPTICS: ON"
            android:textColor="#E5B869"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbSound"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:buttonTint="#00F0FF"
            android:checked="true"
            android:text="SOUND: ON"
            android:textColor="#00F0FF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivAszsdWatermark"
        android:layout_width="84dp"
        android:layout_height="25dp"
        android:layout_marginBottom="14dp"
        android:alpha="0.45"
        android:contentDescription="ASZSD Monogram Emblem"
        android:src="@drawable/ic_aszsd_monogram"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
