<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guideScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Drag Handle Pill -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#33FFFFFF" />

        <!-- Editorial Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.22"
                    android:text="A E T H E R  //  M A N U A L"
                    android:textColor="@color/accent_gold"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="INTERACTIVE HARDWARE &amp; DSP GUIDE"
                    android:textColor="@color/text_white"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloseGuide"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_cred_button_3d"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="CLOSE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.03"
            android:text="Tap [ ? GUIDE ] anytime or long-press any physical control card to inspect its acoustic behavior."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Dynamic Container for the 7 Feature Modules -->
        <LinearLayout
            android:id="@+id/guideItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

