<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom dark drop shadow -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#050608" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Top specular bevel & obsidian face -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#101318"
                android:startColor="#181C24" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#2D3342" />
        </shape>
    </item>
</layer-list>

