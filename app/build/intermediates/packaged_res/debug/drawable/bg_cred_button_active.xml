<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active Depth Glow Base -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#022B3A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Active Surface -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0C2533"
                android:startColor="#133E53" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#00F0FF" />
        </shape>
    </item>
</layer-list>

